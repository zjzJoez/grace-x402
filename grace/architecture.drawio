        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#4A7DD6;strokeWidth=2;endArrow=block;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="ec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3l" value="3 POST /checkout → 402 → sign → retry" style="edgeLabel;html=1;fontSize=10;fontColor=#4A7DD6;" vertex="1" connectable="0" parent="f3">
          <mxGeometry x="-0.1" y="-1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

