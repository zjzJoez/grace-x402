        <mxCell id="f9l" value="confirm URL" style="edgeLabel;html=1;fontSize=10;fontColor=#8A94A6;" vertex="1" connectable="0" parent="f9">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ============ FOOTER: the asymmetry ============ -->
        <mxCell id="foot" value="&lt;b&gt;The asymmetry IS the product&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp; only the merchant can cash it &amp;nbsp;·&amp;nbsp; only the payer can void it &amp;nbsp;·&amp;nbsp; nobody can do both &amp;nbsp;·&amp;nbsp; no escrow, no custodian, no new contract&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5A6472&quot;&gt;The money never leaves the payer's wallet during the window, so reversal costs nothing — nothing moved. Settlement, once it happens, is final.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#B9C4D4;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="596" width="1510" height="66" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
