          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5l" value="5 wake" style="edgeLabel;html=1;fontSize=10;fontColor=#C07800;" vertex="1" connectable="0" parent="f5">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#F0A030;strokeWidth=2;endArrow=block;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="ec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6l" value="6 settle" style="edgeLabel;html=1;fontSize=10;fontColor=#C07800;" vertex="1" connectable="0" parent="f6">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#3E9E6A;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2" target="recv">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1050" y="199" /><mxPoint x="1050" y="264" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f7l" value="7 receiveWithAuthorization" style="edgeLabel;html=1;fontSize=10;fontColor=#2E7D52;" vertex="1" connectable="0" parent="f7">
